# Run: bash deploy.sh init
# init replaces the placeholder values with independent random secrets in .env.
# Both applications read this SAME file; do not generate per-instance secrets.
POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
POSTGRES_PASSWORD=__GENERATE_POSTGRES__
REDIS_PASSWORD=__GENERATE_REDIS__
REDIS_DB=0
JWT_SECRET=__GENERATE_JWT__
TOTP_ENCRYPTION_KEY=__GENERATE_TOTP__
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=__GENERATE_ADMIN__

BIND_HOST=0.0.0.0
MASTER_PORT=8080
SALVE_PORT=8081
MASTER_IMAGE=sub2api-ray:master
SALVE_IMAGE=sub2api-ray:salve
TZ=Asia/Shanghai
RUN_MODE=standard
JWT_EXPIRE_HOUR=24

# Sum of both application pools + migrations/background jobs must fit PostgreSQL.
POSTGRES_MAX_CONNECTIONS=200
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
REDIS_POOL_SIZE=256
REDIS_MIN_IDLE_CONNS=10
SETUP_MIGRATION_TIMEOUT_SECONDS=600

# Shared-service images; PGDATA is explicitly persisted for PostgreSQL 18.
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8-alpine

# Source build; uses the repository-root Dockerfile, including the ray frontend.
NODE_IMAGE=node:24-alpine
GOLANG_IMAGE=golang:1.27.3-alpine
ALPINE_IMAGE=alpine:3.21
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn
NPM_CONFIG_REGISTRY=https://registry.npmjs.org

# OAuth integrations, when needed. Leave unused values empty.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
GEMINI_CLI_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
